# Optional. `docker compose up -d --build` works without any .env: the
# secrets below are generated on first start. Copy to .env (never commit
# it) only to override something. docs/deployment.md explains every step.
#
# Every setting is listed, commented out with its default. Uncomment only
# what you change; apply with `docker compose up -d`. Lists are JSON.
# Source of truth: backend/src/akasha/config.py.

# --- Secrets (docs/deployment.md §3) -----------------------------------
# Own secrets instead of generated ones. Never change them on an existing
# installation. Restoring a backup on a fresh installation needs the key
# that wrote it here.
#
# PostgreSQL password; it goes into a URL, so keep it URL-safe (hex):
#   python3 -c "import secrets; print(secrets.token_hex(24))"
# POSTGRES_PASSWORD=
#
# Encrypts stored credentials. 32 random bytes, URL-safe base64:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# AKASHA_CREDENTIAL_ENCRYPTION_KEY=

# --- Compose ------------------------------------------------------------
# Host port and address of the UI, which also serves the API under /api.
# AKASHA_HTTP_PORT=8080
# AKASHA_BIND_ADDRESS=127.0.0.1
# Tag of the locally built images.
# AKASHA_IMAGE_TAG=0.1.0

# Set by Compose or the image; outside Compose (`uv run akasha ...`) they
# are yours to set. Do not override them here:
# AKASHA_DATABASE_URL=postgresql://akasha:<password>@postgres:5432/akasha
# AKASHA_REDIS_URL=redis://redis:6379/0
# AKASHA_WORKER_ENABLED=false
# AKASHA_ENVIRONMENT=production
# AKASHA_HOST=0.0.0.0
# AKASHA_PORT=8000
# AKASHA_PLUGINS_DIR=/var/lib/akasha/plugins
# AKASHA_WORKSPACE_DIR=/var/lib/akasha/workspace

# --- General ------------------------------------------------------------
# AKASHA_LOG_LEVEL=INFO
# Request body cap for the API (keep it above the 16 MiB package limit).
# AKASHA_API_MAX_REQUEST_BYTES=20971520
# AKASHA_WEBHOOK_MAX_PAYLOAD_BYTES=1048576

# --- LLM providers ------------------------------------------------------
# openai and anthropic are always available; their API keys are stored as
# credentials in the UI, never here. Ceiling for one LLM request:
# AKASHA_LLM_TIMEOUT_SECONDS=60
# Any number of OpenAI-compatible endpoints (OpenRouter, vLLM, LM Studio,
# Ollama at /v1, ...). Each name shows up as a provider; keys again as
# credentials. Keyless local servers set "requires_credential": false.
# AKASHA_LLM_ENDPOINTS=[{"name": "openrouter", "base_url": "https://openrouter.ai/api/v1"}, {"name": "ollama", "base_url": "http://ollama:11434/v1", "requires_credential": false}]

# --- Network and built-in nodes ----------------------------------------
# core.http/core.smtp may not reach private/loopback addresses unless
# allowed globally or per host.
# AKASHA_NETWORK_ALLOW_PRIVATE=false
# AKASHA_NETWORK_ALLOWED_HOSTS=["intranet.example"]
# AKASHA_HTTP_MAX_RESPONSE_BYTES=5242880
# SearXNG for core.web_search; Compose defaults to the bundled one.
# AKASHA_WEB_SEARCH_URL=http://searxng:8080
# AKASHA_WORKSPACE_MAX_FILE_BYTES=1048576
# Agent tools (ADR 0005). core.command is off until programs are listed.
# Not a sandbox: an interpreter (python3, bash) lets every workflow run
# arbitrary code as the engine's OS user.
# AKASHA_COMMAND_ALLOWED=["git", "jq"]
# AKASHA_COMMAND_MAX_OUTPUT_BYTES=262144

# --- Authentication and monitoring -------------------------------------
# AKASHA_SESSION_TTL_SECONDS=43200
# false only for plain-HTTP setups on a non-localhost address.
# AKASHA_SESSION_COOKIE_SECURE=true
# Bearer token (>= 32 chars) for Prometheus on /metrics; unset → admins only.
# AKASHA_METRICS_TOKEN=
# AKASHA_LIVE_POLL_SECONDS=0.5

# --- Plugins and MCP (docs/mcp.md) -------------------------------------
# Plugin uploads over HTTP / MCP make every admin as powerful as shell
# access to the host (ADR 0001, 0006).
# AKASHA_PLUGINS_HTTP_INSTALL=false
# Operator settings per plugin id, checked against the plugin manifest's
# settings_schema; the plugin's nodes read them as context.settings. No
# secrets here: use credentials.
# AKASHA_PLUGIN_SETTINGS={"acme": {"endpoint": "http://intranet/api"}}
# AKASHA_MCP_ENABLED=false
# AKASHA_MCP_PLUGIN_CODE=false
# AKASHA_MCP_MAX_REQUEST_BYTES=4194304
# AKASHA_MCP_MAX_RESPONSE_BYTES=262144

# --- Workers, queue, scheduler -----------------------------------------
# AKASHA_QUEUE_PREFIX=akasha
# AKASHA_WORKER_CONCURRENCY=4
# AKASHA_WORKER_POLL_SECONDS=1.0
# AKASHA_WORKER_HEARTBEAT_SECONDS=5.0
# AKASHA_WORKER_SHUTDOWN_GRACE_SECONDS=30.0
# AKASHA_QUEUE_RECOVERY_SECONDS=30.0
# At least 3 heartbeats.
# AKASHA_EXECUTION_STALE_SECONDS=60.0
# AKASHA_SCHEDULER_ENABLED=true
# AKASHA_SCHEDULER_POLL_SECONDS=1.0

# --- Resource limits ----------------------------------------------------
# Timeouts are both the default and the maximum a request may ask for.
# AKASHA_LIMIT_EXECUTION_TIMEOUT_SECONDS=3600
# AKASHA_LIMIT_NODE_TIMEOUT_SECONDS=900
# AKASHA_LIMIT_NODE_ATTEMPTS=5
# AKASHA_LIMIT_GRAPH_NODES=500
# AKASHA_LIMIT_GRAPH_DEPTH=100
# AKASHA_LIMIT_ACTIVE_EXECUTIONS_PER_WORKFLOW=100
# AKASHA_LIMIT_EXECUTION_CONCURRENCY=8
# AKASHA_LIMIT_NODE_OUTPUT_BYTES=1048576
# AKASHA_LIMIT_EXECUTION_OUTPUT_BYTES=16777216
# AKASHA_LIMIT_LLM_OUTPUT_TOKENS=16384
# AKASHA_LIMIT_EVENT_TRIGGER_DEPTH=8
